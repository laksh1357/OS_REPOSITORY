# Warden Environment & PostgreSQL Configuration Example

# PostgreSQL Database Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warden_db
POSTGRES_USER=warden
POSTGRES_PASSWORD=warden_secret_pass

# Full Connection URI
DATABASE_URL=postgresql://warden:warden_secret_pass@localhost:5432/warden_db?sslmode=disable

# Warden Sandbox Engine Settings
WARDEN_ENVIRONMENT=development
WARDEN_DEFAULT_RUNTIME=microvm
WARDEN_LOG_LEVEL=info
